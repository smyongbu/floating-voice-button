<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/historyRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7FB" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="56dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="识别历史" android:textColor="#0F172A" android:textSize="24sp" android:textStyle="bold" />
            <Button android:id="@+id/clearButton" android:layout_width="88dp" android:layout_height="48dp" android:background="@drawable/secondary_button" android:text="清空全部" android:textAllCaps="false" android:textColor="#B91C1C" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:id="@+id/historyCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0 条记录" android:textColor="#475569" android:textSize="14sp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1">
            <ListView android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:divider="@android:color/transparent" android:dividerHeight="12dp" android:paddingBottom="24dp" />
            <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="还没有识别历史&#10;完成一次识别后会自动保存在这里" android:textAlignment="center" android:textColor="#64748B" android:textSize="16sp" />
        </FrameLayout>
    </LinearLayout>
    <include layout="@layout/bottom_navigation" />
</LinearLayout>
